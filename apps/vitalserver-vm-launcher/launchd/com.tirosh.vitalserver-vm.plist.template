<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tirosh.vitalserver-vm</string>

  <key>ProgramArguments</key>
  <array>
    <string>${VITALSERVER_VM_BIN}</string>
    <string>start</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>VITALSERVER_VM_HOME</key>
    <string>${VITALSERVER_VM_HOME}</string>
    <key>VITALSERVER_VM_DETACHED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>${VITALSERVER_VM_HOME}/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>${VITALSERVER_VM_HOME}/logs/launchd.err.log</string>
</dict>
</plist>
