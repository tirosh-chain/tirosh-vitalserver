#!/usr/bin/env bash
set -euo pipefail

MOUNT_TAG="${TIROSH_SHARE_TAG:-tirosh}"
MOUNT_POINT="${TIROSH_SHARE_MOUNT:-/mnt/tirosh}"
DEPLOY_DIR="${TIROSH_DEPLOY_DIR:-${MOUNT_POINT}/deploy}"
RUNTIME_DIR="${MOUNT_POINT}/run"
REQUEST_FILE="${RUNTIME_DIR}/repair-datastore.request"
RESULT_FILE="${RUNTIME_DIR}/repair-datastore-result.json"
LOG_FILE="${RUNTIME_DIR}/repair-datastore.log"
PROJECT_NAME="vitalserver"
REDIS_VOLUME="${PROJECT_NAME}_redis-data"

mount_runtime_share() {
  mkdir -p "${MOUNT_POINT}"
  if ! mountpoint -q "${MOUNT_POINT}"; then
    mount -t virtiofs "${MOUNT_TAG}" "${MOUNT_POINT}"
  fi
  mkdir -p "${RUNTIME_DIR}"
}

write_result() {
  local status="$1"
  local message="$2"
  local updated_at

  updated_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  cat > "${RESULT_FILE}" <<EOF
{
  "message" : "${message}",
  "status" : "${status}",
  "updatedAt" : "${updated_at}"
}
EOF
}

repair_appendonly_file() {
  if ! docker volume inspect "${REDIS_VOLUME}" >/dev/null 2>&1; then
    printf "redis volume does not exist: %s\n" "${REDIS_VOLUME}"
    return
  fi

  docker run --rm \
    -v "${REDIS_VOLUME}:/data" \
    redis:3.2.12-alpine \
    sh -c '
      set -eu
      if [ ! -f /data/appendonly.aof ]; then
        echo "appendonly.aof does not exist; nothing to repair"
        exit 0
      fi
      if redis-check-aof /data/appendonly.aof; then
        echo "appendonly.aof is valid"
        exit 0
      fi
      backup="/data/appendonly.aof.bak.$(date +%Y%m%d%H%M%S)"
      cp /data/appendonly.aof "$backup"
      printf "created backup: %s\n" "$backup"
      printf "y\n" | redis-check-aof --fix /data/appendonly.aof
    '
}

restart_runtime_compose() {
  eval "$(/usr/local/bin/tirosh-runtime-env "${DEPLOY_DIR}/runtime-config.json")"
  docker compose --project-name "${PROJECT_NAME}" -f "${DEPLOY_DIR}/compose.yaml" stop app redis-ui edge redis || true
  repair_appendonly_file
  /usr/local/bin/tirosh-vitalserver-compose up
  /usr/local/bin/tirosh-runtime-state once || true
}

main() {
  mount_runtime_share
  : > "${LOG_FILE}"
  exec > >(tee -a "${LOG_FILE}") 2>&1

  printf "datastore repair started\n"
  if [ ! -f "${REQUEST_FILE}" ]; then
    printf "request file is missing; exiting\n"
    write_result "skipped" "request file is missing"
    return
  fi

  if restart_runtime_compose; then
    rm -f "${REQUEST_FILE}"
    write_result "completed" "Redis append-only file checked and VitalServer services restarted."
    printf "datastore repair completed\n"
  else
    write_result "failed" "Datastore repair failed. See repair-datastore.log."
    printf "datastore repair failed\n" >&2
    return 1
  fi
}

main "$@"
