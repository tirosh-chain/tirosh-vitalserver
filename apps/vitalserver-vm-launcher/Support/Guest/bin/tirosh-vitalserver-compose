#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-up}"
MOUNT_TAG="${TIROSH_SHARE_TAG:-tirosh}"
MOUNT_POINT="${TIROSH_SHARE_MOUNT:-/mnt/tirosh}"
VITAL_FILES_MOUNT_TAG="${TIROSH_VITAL_FILES_SHARE_TAG:-tirosh-vital-files}"
VITAL_FILES_MOUNT_POINT="${TIROSH_VITAL_FILES_SHARE_MOUNT:-/mnt/tirosh-vital-files}"
DEPLOY_DIR="${TIROSH_DEPLOY_DIR:-${MOUNT_POINT}/deploy}"

mkdir -p "${MOUNT_POINT}"
if ! mountpoint -q "${MOUNT_POINT}"; then
  mount -t virtiofs "${MOUNT_TAG}" "${MOUNT_POINT}"
fi

mkdir -p "${VITAL_FILES_MOUNT_POINT}"
if ! mountpoint -q "${VITAL_FILES_MOUNT_POINT}"; then
  mount -t virtiofs "${VITAL_FILES_MOUNT_TAG}" "${VITAL_FILES_MOUNT_POINT}"
fi

eval "$(/usr/local/bin/tirosh-runtime-env "${DEPLOY_DIR}/runtime-config.json")"

compose() {
  docker compose --project-name vitalserver -f "${DEPLOY_DIR}/compose.yaml" "$@"
}

wait_for_redis() {
  local deadline

  deadline=$(( "$(date +%s)" + 120 ))
  while [ "$(date +%s)" -lt "${deadline}" ]; do
    if compose exec -T redis redis-cli ping 2>/dev/null | grep -q PONG; then
      return
    fi
    sleep 2
  done

  printf "error: redis did not become ready\n" >&2
  compose ps >&2 || true
  compose logs redis --tail=100 >&2 || true
  exit 1
}

wait_for_app() {
  local deadline

  deadline=$(( "$(date +%s)" + 180 ))
  while [ "$(date +%s)" -lt "${deadline}" ]; do
    if compose exec -T app node -e "require('http').get('http://127.0.0.1/check', r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))" >/dev/null 2>&1; then
      return
    fi
    sleep 2
  done

  printf "error: app did not become healthy\n" >&2
  compose ps >&2 || true
  compose logs app --tail=100 >&2 || true
  exit 1
}

start_ordered() {
  compose up -d redis
  wait_for_redis
  compose up -d app redis-ui swagger-ui
  wait_for_app
  compose up -d edge
}

case "${ACTION}" in
  up)
    start_ordered
    ;;
  stop)
    exec docker compose --project-name vitalserver -f "${DEPLOY_DIR}/compose.yaml" stop
    ;;
  *)
    printf "usage: tirosh-vitalserver-compose [up|stop]\n" >&2
    exit 2
    ;;
esac
