# Ubuntu cloud image download settings for local VM image preparation.
# This file is used by Support/Build/download-ubuntu.sh and is intentionally small
# enough to review during release image updates.

VM_UBUNTU_RELEASE=noble
VM_UBUNTU_VERSION=24.04
VM_UBUNTU_BASE_URL=https://cloud-images.ubuntu.com/releases/noble/release

# auto follows the macOS host architecture: arm64 on Apple Silicon, amd64 on Intel.
VM_UBUNTU_ARCH=auto

VM_UBUNTU_KERNEL_SUFFIX=vmlinuz-generic
VM_UBUNTU_INITRD_SUFFIX=initrd-generic
