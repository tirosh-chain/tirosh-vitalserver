#!/usr/bin/env bash
set -Eeuo pipefail

product_root="/Library/Application Support/TiroshVitalServer"
vm_home="${product_root}/vm"
install_log="${product_root}/logs/install.log"
vm_bin="/usr/local/bin/vitalserver-vm"

mkdir -p "$(dirname "${install_log}")"
exec > >(tee -a "${install_log}") 2>&1

log() {
  printf "[%s] %s\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*"
}

on_error() {
  local status="$?"
  log "postinstall failed status=${status} command=${BASH_COMMAND}"
  exit "${status}"
}

trap on_error ERR

log "Tirosh VitalServer postinstall started"
VITALSERVER_VM_HOME="${vm_home}" "${vm_bin}" runtime install
log "Tirosh VitalServer postinstall completed"
