#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  printf "This uninstaller must run as root.\n" >&2
  printf "Run: sudo tirosh-vitalserver-uninstall\n" >&2
  exit 1
fi

labels=(
  "com.tirosh.vitalserver-proxy"
  "com.tirosh.vitalserver-vm"
)

printf "Stopping launchd services...\n"
for label in "${labels[@]}"; do
  if launchctl print "system/${label}" >/dev/null 2>&1; then
    printf "  unloading %s\n" "${label}"
    launchctl bootout "system/${label}" >/dev/null 2>&1 || true
  else
    printf "  %s is not loaded\n" "${label}"
  fi
done

printf "Removing launchd plists and command line tools...\n"
rm -f \
  /Library/LaunchDaemons/com.tirosh.vitalserver-vm.plist \
  /Library/LaunchDaemons/com.tirosh.vitalserver-proxy.plist \
  /usr/local/bin/vitalserver-vm \
  /usr/local/bin/vitalserver-proxy-run \
  /usr/local/bin/tirosh-vitalserver-uninstall

printf "Removing runtime data and bundled nginx...\n"
rm -rf "/Library/Application Support/TiroshVitalServer"

printf "Forgetting package receipt...\n"
pkgutil --forget com.tirosh.vitalserver.vm >/dev/null 2>&1 || true

printf "Tirosh VitalServer VM runtime has been removed.\n"
