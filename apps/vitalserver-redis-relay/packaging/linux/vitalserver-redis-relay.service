# EXAMPLE systemd unit. install.py copies this file to
# /etc/systemd/system when an operator runs it. Product PKG packaging does
# not install or enable this unit. systemd owns process lifetime and restart.

[Unit]
Description=VitalServer Redis Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vitalserver-redis-relay
Group=vitalserver-redis-relay
ExecStart=/opt/vitalserver/redis-relay/venv/bin/vitalserver-redis-relay --config-path /etc/vitalserver/redis-relay.toml --status-path /var/lib/vitalserver/redis-relay/status.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
