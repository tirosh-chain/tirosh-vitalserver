#!/usr/bin/env bash
set -euo pipefail

MOUNT_TAG="${TIROSH_SHARE_TAG:-tirosh}"
MOUNT_POINT="${TIROSH_SHARE_MOUNT:-/mnt/tirosh}"
DEPLOY_DIR="${TIROSH_DEPLOY_DIR:-${MOUNT_POINT}/deploy}"
RUNTIME_DIR="${TIROSH_RUNTIME_DIR:-${MOUNT_POINT}/run}"
BACKUP_DIR="${MOUNT_POINT}/backups/redis"
REQUEST_FILE="${RUNTIME_DIR}/prepare-update-shutdown.request"
RESULT_FILE="${RUNTIME_DIR}/prepare-update-shutdown-result.json"
LOG_FILE="${RUNTIME_DIR}/prepare-update-shutdown.log"
REQUEST_ID=""
REQUEST_VERSION=""
REDIS_BACKUP_PATH=""

mount_runtime_share() {
  mkdir -p "${MOUNT_POINT}"
  if ! mountpoint -q "${MOUNT_POINT}"; then
    mount -t virtiofs "${MOUNT_TAG}" "${MOUNT_POINT}"
  fi
  mkdir -p "${RUNTIME_DIR}"
}

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"
}

load_request_metadata() {
  if ! command -v python3 >/dev/null 2>&1; then
    printf "error: python3 is required to read shutdown request metadata\n" >&2
    return 1
  fi

  REQUEST_ID="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("requestId", ""))' "${REQUEST_FILE}")"
  REQUEST_VERSION="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version", ""))' "${REQUEST_FILE}")"
  if [ -z "${REQUEST_ID}" ]; then
    printf "error: shutdown request is missing requestId\n" >&2
    return 1
  fi
}

write_result() {
  local status="$1"
  local message="$2"
  local step="${3:-}"
  local reason="${4:-}"

  python3 - "${RESULT_FILE}" "${REQUEST_ID}" "${status}" "${message}" "${step}" "${reason}" "${REDIS_BACKUP_PATH}" <<'PY'
import json
import sys
from datetime import datetime, timezone

path, request_id, status, message, step, reason, redis_backup_path = sys.argv[1:8]
document = {
    "operation": "prepare-update-shutdown",
    "requestId": request_id,
    "schemaVersion": 1,
    "message": message,
    "status": status,
    "updatedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
}
if step:
    document["step"] = step
if reason:
    document["reasonCodes"] = [reason]
if redis_backup_path:
    document["redisBackupPath"] = redis_backup_path
with open(path, "w", encoding="utf-8") as handle:
    json.dump(document, handle, indent=2, sort_keys=True)
    handle.write("\n")
PY
}

on_error() {
  local status="$?"
  local command="${BASH_COMMAND:-unknown}"
  trap - ERR
  log "status=failed exit=${status} command=${command}"
  write_result "failed" "Guest update shutdown failed at: ${command}" "failed" "guest-update-shutdown-failed" || true
  exit "${status}"
}

backup_redis() {
  log "step=redis-backup status=started"
  /usr/local/bin/tirosh-vitalserver-redis-backup
  REDIS_BACKUP_PATH="$(find "${BACKUP_DIR}" -name 'redis-*.tar.gz' -type f | sort | tail -n 1 || true)"
  if [ -z "${REDIS_BACKUP_PATH}" ] || [ ! -s "${REDIS_BACKUP_PATH}" ]; then
    printf "error: redis backup archive was not created\n" >&2
    return 1
  fi
  log "step=redis-backup status=completed archive=${REDIS_BACKUP_PATH}"
}

stop_runtime_services() {
  log "step=guest-services-stop status=started"
  systemctl stop tirosh-vitalserver-container-logs.service >/dev/null 2>&1 || true
  systemctl stop tirosh-runtime-state.service >/dev/null 2>&1 || true
  /usr/local/bin/tirosh-vitalserver-compose stop
  log "step=guest-services-stop status=completed"
}

sync_filesystems() {
  log "step=sync status=started"
  sync
  log "step=sync status=completed"
}

main() {
  mount_runtime_share
  : > "${LOG_FILE}"
  exec > >(tee -a "${LOG_FILE}") 2>&1
  trap on_error ERR

  log "guest update shutdown preparation started"
  if [ ! -f "${REQUEST_FILE}" ]; then
    printf "request file is missing; exiting\n"
    REQUEST_ID=""
    return
  fi

  load_request_metadata
  log "requestId=${REQUEST_ID} version=${REQUEST_VERSION:-unknown}"
  write_result "running" "Guest update shutdown preparation started." "starting"
  backup_redis
  write_result "running" "Redis backup completed. Stopping guest services." "redis-backup"
  stop_runtime_services
  sync_filesystems
  write_result "ready" "Guest services are stopped and filesystems are synced." "ready"
  rm -f "${REQUEST_FILE}"
  log "guest update shutdown preparation ready"
}

main "$@"
