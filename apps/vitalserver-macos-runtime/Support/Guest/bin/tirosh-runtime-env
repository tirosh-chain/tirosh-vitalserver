#!/usr/bin/env python3
import json
import shlex
import sys
from pathlib import Path


DEFAULT_CONFIG = {
    "adminPassword": "admin",
    "publicHost": "",
    "publicPort": "",
    "redisHost": "redis",
    "redisPort": 6379,
    "trustProxy": True,
    "testkitEnabled": True,
    "vitalFilesDirectory": "/mnt/tirosh-vital-files",
}


def export_line(name: str, value: object) -> str:
    if isinstance(value, bool):
        value = "1" if value else "0"
    return f"export {name}={shlex.quote(str(value))}"


def load_config(config_path: Path) -> dict:
    with config_path.open(encoding="utf-8") as handle:
        config = json.load(handle)
    return {**DEFAULT_CONFIG, **config}


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: tirosh-runtime-env <runtime-config.json>", file=sys.stderr)
        return 2

    config_path = Path(sys.argv[1])
    if not config_path.is_file():
        print(f"error: missing {config_path}", file=sys.stderr)
        return 1

    config = load_config(config_path)
    print(export_line("VITALSERVER_REDIS_HOST", config["redisHost"]))
    print(export_line("VITALSERVER_REDIS_PORT", config["redisPort"]))
    print(export_line("VITALSERVER_TRUST_PROXY", config["trustProxy"]))
    print(export_line("VITALSERVER_PUBLIC_HOST", config["publicHost"]))
    print(export_line("VITALSERVER_PUBLIC_PORT", config["publicPort"]))
    print(export_line("VITALSERVER_ADMIN_PASSWORD", config["adminPassword"]))
    print(export_line("VITALSERVER_VITAL_FILES_DIR", config["vitalFilesDirectory"]))
    print(export_line("TIROSH_TESTKIT_ENABLED", config["testkitEnabled"]))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
