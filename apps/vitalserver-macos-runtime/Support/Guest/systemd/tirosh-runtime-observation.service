[Unit]
Description=Write Tirosh VM runtime observation to shared runtime directory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=VITALSERVER_DATABASE_URL=postgresql+psycopg://vitalserver:vitalserver@127.0.0.1:15432/vitalserver
ExecStart=/usr/local/bin/tirosh-runtime-observation watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
