[Unit]
Description=Synchronize Tirosh guest clock from explicit host time contract
After=local-fs.target
Before=docker.service tirosh-runtime-state.service tirosh-guest-observability.service tirosh-vitalserver-compose.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tirosh-vitalserver-sync-host-time
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
