[Unit]
Description=Tirosh VitalServer optional TestKit service
After=docker.service network-online.target tirosh-vitalserver-compose.service
Requires=docker.service
Wants=network-online.target tirosh-vitalserver-compose.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tirosh-vitalserver-compose testkit-up-logged
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
