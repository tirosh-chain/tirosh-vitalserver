#!/usr/bin/env bash
set -euo pipefail

product_root="/Library/Application Support/TiroshVitalServer"
vm_home="${VITALSERVER_VM_HOME:-${product_root}/vm}"
deploy_dir="${vm_home}/data/deploy"
runtime_config="${deploy_dir}/runtime-config.json"
runtime_settings="${deploy_dir}/runtime-settings.json"

if [ ! -f "${runtime_config}" ]; then
  printf "guest runtime config missing; skipping runtime settings read model: %s\n" "${runtime_config}"
  exit 0
fi

mkdir -p "${deploy_dir}"

if ! python3 - "${runtime_config}" "${runtime_settings}" <<'PY'
import json
import os
import sys

source = sys.argv[1]
destination = sys.argv[2]

try:
    with open(source, "r", encoding="utf-8") as handle:
        config = json.load(handle)

    settings = {
        "publicHost": config.get("publicHost", ""),
        "publicPort": int(config.get("publicPort", 80)),
        "redisBackupRetentionCount": int(config.get("redisBackupRetentionCount", 30)),
    }

    temporary = f"{destination}.tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(settings, handle, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(temporary, destination)
except Exception as error:
    print(f"warning: could not refresh guest runtime settings read model: {error}", file=sys.stderr)
    sys.exit(1)
PY
then
  exit 0
fi

chmod 0644 "${runtime_settings}"
if ! chown root:wheel "${runtime_settings}" 2>/dev/null; then
  printf "warning: could not set owner on guest runtime settings read model: %s\n" "${runtime_settings}" >&2
fi

printf "guest runtime settings read model refreshed: %s\n" "${runtime_settings}"
