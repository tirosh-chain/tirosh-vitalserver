#!/usr/bin/env bash
set -Eeuo pipefail

uninstall_log="${UNINSTALL_LOG}"
exec > >(tee -a "${uninstall_log}") 2>&1

vm_bin="${VM_BIN}"
uninstall="${UNINSTALL}"
clean=false

log() {
  printf "[%s] %s\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*"
}

on_error() {
  local status="$?"
  log "uninstall failed status=${status} command=${BASH_COMMAND}"
  exit "${status}"
}

trap on_error ERR

if [ "$(id -u)" -ne 0 ]; then
  log "This uninstaller must run as root."
  log "Run: sudo tirosh-vitalserver-uninstall [--clean]"
  exit 1
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --clean)
      clean=true
      ;;
    *)
      log "Unknown option: $1"
      log "Usage: sudo tirosh-vitalserver-uninstall [--clean]"
      exit 2
      ;;
  esac
  shift
done

command=("${vm_bin}" "runtime" "uninstall")
if [ "${clean}" = true ]; then
  command+=("--clean")
fi

log "delegating uninstall to HostCLI clean=${clean}"
"${command[@]}"

log "step=remove-uninstaller status=started"
rm -f "${uninstall}"
log "step=remove-uninstaller status=completed"
log "uninstall completed log=${uninstall_log}"
