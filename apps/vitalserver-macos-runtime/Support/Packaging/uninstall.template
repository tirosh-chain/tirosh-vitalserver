#!/usr/bin/env bash
set -Eeuo pipefail

uninstall_log="${UNINSTALL_LOG}"

vm_bin="${VM_BIN}"
vm_home="${VM_HOME}"
uninstall="${UNINSTALL}"
manager_app="${MANAGER_APP}"
clean=false
force_clean=false

log() {
  printf "[%s] %s\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*"
}

on_error() {
  local status="$?"
  log "uninstall failed status=${status} command=${BASH_COMMAND}"
  exit "${status}"
}

trap on_error ERR

if [ "$(id -u)" -ne 0 ]; then
  printf "[%s] This uninstaller must run as root.\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  printf "[%s] Run: sudo tirosh-vitalserver-uninstall [--clean]\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  exit 1
fi

mkdir -p "$(dirname "${uninstall_log}")"
exec > >(tee -a "${uninstall_log}") 2>&1

while [ "$#" -gt 0 ]; do
  case "$1" in
    --clean)
      clean=true
      ;;
    --force-clean|--force-clean-uninstaller)
      clean=true
      force_clean=true
      ;;
    *)
      log "Unknown option: $1"
      log "Usage: sudo tirosh-vitalserver-uninstall [--clean|--force-clean-uninstaller]"
      exit 2
      ;;
  esac
  shift
done

wait_for_helper_app_exit() {
  local helper_executable="${manager_app}/Contents/MacOS/VitalServer Helper"
  local attempts=80
  local index

  if [ ! -x "${helper_executable}" ]; then
    return 0
  fi

  for ((index = 0; index < attempts; index++)); do
    if ! /usr/bin/pgrep -f -- "${helper_executable}" >/dev/null 2>&1; then
      return 0
    fi
    if [ "${index}" -eq 0 ]; then
      log "waiting for Helper app to exit before uninstall cleanup"
    fi
    sleep 0.25
  done

  log "Helper app is still running; aborting uninstall before file removal"
  exit 3
}

wait_for_helper_app_exit

command=("${vm_bin}" "runtime" "uninstall")
if [ "${force_clean}" = true ]; then
  command+=("--force-clean-uninstaller")
elif [ "${clean}" = true ]; then
  command+=("--clean")
fi

log "delegating uninstall to CLIHost clean=${clean} forceClean=${force_clean}"
VITALSERVER_VM_HOME="${vm_home}" "${command[@]}"

if [ -e "${uninstall}" ]; then
  log "uninstaller remains after CLIHost cleanup path=${uninstall}"
  exit 5
fi
log "terminal cleanup verified uninstaller=${uninstall}"
log "uninstall completed log=${uninstall_log}"
