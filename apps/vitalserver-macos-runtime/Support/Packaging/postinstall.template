#!/usr/bin/env bash
set -Eeuo pipefail

product_root="${PRODUCT_ROOT}"
vm_home="${VM_HOME}"
install_log="${INSTALL_LOG}"
vm_bin="${VM_BIN}"
manager_app="${MANAGER_APP}"
runtime_status="${product_root}/status/runtime-status.json"
max_log_bytes=$((10 * 1024 * 1024))
keep_log_count=5
postinstall_timeout_seconds=900
progress_log_interval_seconds=10

mkdir -p "$(dirname "${install_log}")"

rotate_install_log() {
  [ -f "${install_log}" ] || return 0
  [ "$(stat -f%z "${install_log}")" -lt "${max_log_bytes}" ] && return 0

  local index source destination
  for ((index = keep_log_count - 1; index >= 1; index--)); do
    source="${install_log}.${index}"
    destination="${install_log}.$((index + 1))"
    [ -f "${destination}" ] && rm -f "${destination}"
    [ -f "${source}" ] && mv "${source}" "${destination}"
  done
  mv "${install_log}" "${install_log}.1"
}

rotate_install_log
exec > >(tee -a "${install_log}") 2>&1

log() {
  printf "[%s] %s\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*"
}

on_error() {
  local status="$?"
  log "postinstall failed status=${status} command=${BASH_COMMAND}"
  exit "${status}"
}

trap on_error ERR

json_raw_value() {
  local key="$1"
  [ -f "${runtime_status}" ] || return 0
  /usr/bin/plutil -extract "${key}" raw -o - "${runtime_status}" 2>/dev/null || true
}

json_value() {
  local key="$1"
  [ -f "${runtime_status}" ] || return 0
  /usr/bin/plutil -extract "${key}" json -o - "${runtime_status}" 2>/dev/null | tr -d '\n' || true
}

log_runtime_install_status() {
  local status operation step step_status message progress_message failure_reasons

  if [ ! -f "${runtime_status}" ]; then
    log "runtime install progress statusFile=missing path=${runtime_status}"
    return
  fi

  status="$(json_raw_value "status")"
  operation="$(json_raw_value "operation")"
  step="$(json_raw_value "progress.step")"
  step_status="$(json_raw_value "progress.stepStatus")"
  message="$(json_raw_value "message")"
  progress_message="$(json_raw_value "progress.message")"
  failure_reasons="$(json_value "failureReasons")"

  log "runtime install progress status=${status:-unknown} operation=${operation:-unknown} step=${step:-none} stepStatus=${step_status:-none} message=${message:-none}"
  if [ -n "${progress_message}" ] && [ "${progress_message}" != "${message}" ]; then
    log "runtime install progress detail=${progress_message}"
  fi
  if [ -n "${failure_reasons}" ] && [ "${failure_reasons}" != "[]" ]; then
    log "runtime install progress failureReasons=${failure_reasons}"
  fi
}

run_runtime_install_with_timeout() {
  local deadline last_progress_log now pid status
  deadline=$(( $(date +%s) + postinstall_timeout_seconds ))
  last_progress_log=0

  VITALSERVER_VM_HOME="${vm_home}" "${vm_bin}" runtime install &
  pid="$!"
  log "runtime install process started pid=${pid} timeoutSeconds=${postinstall_timeout_seconds}"
  log_runtime_install_status

  while kill -0 "${pid}" 2>/dev/null; do
    now="$(date +%s)"
    if [ $((now - last_progress_log)) -ge "${progress_log_interval_seconds}" ]; then
      log_runtime_install_status
      last_progress_log="${now}"
    fi
    if [ "$(date +%s)" -ge "${deadline}" ]; then
      log_runtime_install_status
      log "runtime install timed out timeoutSeconds=${postinstall_timeout_seconds} pid=${pid}"
      kill -TERM "${pid}" 2>/dev/null || true
      sleep 5
      if kill -0 "${pid}" 2>/dev/null; then
        log "runtime install did not stop after TERM; sending KILL pid=${pid}"
        kill -KILL "${pid}" 2>/dev/null || true
      fi
      wait "${pid}" 2>/dev/null || true
      return 124
    fi
    sleep 2
  done

  status=0
  wait "${pid}" || status="$?"
  log_runtime_install_status
  log "runtime install process exited status=${status} pid=${pid}"
  return "${status}"
}

log "Tirosh VitalServer postinstall started"
if [ ! -d "${manager_app}" ]; then
  log "helper app missing path=${manager_app}"
  exit 1
fi
run_runtime_install_with_timeout
log "Tirosh VitalServer postinstall completed"
