#!/usr/bin/env bash
set -Eeuo pipefail

vm_home="${VM_HOME}"
product_root="${PRODUCT_ROOT}"
install_log="${INSTALL_LOG}"
vm_bin="${VM_BIN}"
host_installation_manager="${HOST_INSTALLATION_MANAGER}"
host_installation_database="${HOST_INSTALLATION_DATABASE}"
host_platform_installation_root="${HOST_PLATFORM_INSTALLATION_ROOT}"
proxy_run="${PROXY_RUN}"
uninstall="${UNINSTALL}"
manager_app="${MANAGER_APP}"
launch_daemons_dir="${LAUNCH_DAEMONS_DIR}"
script_dir="$(cd "$(dirname "$0")" && pwd)"
package_install_contract="${script_dir}/package-install-contract.json"
initial_host_installation_manifest="${script_dir}/initial-host-platform-installation.json"
initial_release_root="${INITIAL_RELEASE_ROOT}"
failure_log="/private/tmp/tirosh-vitalserver-postinstall-failure.log"
max_log_bytes=$((10 * 1024 * 1024))
keep_log_count=5

mkdir -p "$(dirname "${install_log}")"

rotate_install_log() {
  [ -f "${install_log}" ] || return 0
  [ "$(stat -f%z "${install_log}")" -lt "${max_log_bytes}" ] && return 0

  local index source destination
  for ((index = keep_log_count - 1; index >= 1; index--)); do
    source="${install_log}.${index}"
    destination="${install_log}.$((index + 1))"
    [ -f "${destination}" ] && rm -f "${destination}"
    [ -f "${source}" ] && mv "${source}" "${destination}"
  done
  mv "${install_log}" "${install_log}.1"
}

rotate_install_log
exec > >(tee -a "${install_log}") 2>&1

log() {
  printf "[%s] %s\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*"
}

on_error() {
  local status="$?"
  log "postinstall failed status=${status} command=${BASH_COMMAND}"
  preserve_failure_log
  stop_services_after_failed_install
  exit "${status}"
}

trap on_error ERR

preserve_failure_log() {
  if [ -f "${install_log}" ]; then
    cp -p "${install_log}" "${failure_log}" 2>/dev/null || true
    log "postinstall failure log preserved path=${failure_log}"
  fi
}

stop_services_after_failed_install() {
  log "postinstall failure service stop started; persistent runtime data and package artifacts will be preserved"
  trap - ERR

  if [ -x "${vm_bin}" ]; then
    if VITALSERVER_VM_HOME="${vm_home}" "${vm_bin}" runtime stop-package-services; then
      log "postinstall failure cleanup stopped runtime services"
    else
      local stop_status="$?"
      log "postinstall failure cleanup service stop skipped status=${stop_status}"
    fi
  else
    log "postinstall failure cleanup service stop unavailable vm_bin=${vm_bin}"
  fi

  log "postinstall failure service stop completed"

  trap on_error ERR
}

log "VitalServer Helper postinstall started"
if [ ! -L "${host_platform_installation_root}/current" ]; then
  log "current Helper Host release link missing path=${host_platform_installation_root}/current"
  exit 1
fi
if [ "$(readlink "${host_platform_installation_root}/current")" != "${initial_release_root}" ]; then
  log "current Helper Host release target differs path=${host_platform_installation_root}/current"
  exit 1
fi
if [ -L "${manager_app}" ]; then
  log "helper app must be a materialized application bundle, not a symbolic link path=${manager_app}"
  exit 1
fi
if [ ! -d "${manager_app}" ]; then
  log "helper app bundle missing path=${manager_app}"
  exit 1
fi
if [ ! -f "${manager_app}/Contents/Info.plist" ]; then
  log "helper app Info.plist missing path=${manager_app}/Contents/Info.plist"
  exit 1
fi
if [ ! -x "${manager_app}/Contents/MacOS/VitalServer Helper" ]; then
  log "helper app executable missing path=${manager_app}/Contents/MacOS/VitalServer Helper"
  exit 1
fi
if [ ! -x "${host_installation_manager}" ]; then
  log "host installation manager missing path=${host_installation_manager}"
  exit 1
fi
mkdir -p "$(dirname "${host_installation_database}")"
"${host_installation_manager}" initialize \
  --manifest "${initial_host_installation_manifest}" \
  --database "${host_installation_database}"
VITALSERVER_VM_HOME="${vm_home}" "${vm_bin}" runtime install-provision \
  --package-install-contract "${package_install_contract}"
log "VitalServer Helper postinstall completed"
