#!/usr/bin/env bash
set -Eeuo pipefail

product_root="${PRODUCT_ROOT}"
vm_home="${VM_HOME}"
install_log="${INSTALL_LOG}"
vm_bin="${VM_BIN}"
proxy_run="${PROXY_RUN}"
uninstaller="${UNINSTALL}"
manager_app="${MANAGER_APP}"
nginx_prefix="${NGINX_PREFIX}"
nginx_bin="${nginx_prefix}/sbin/nginx"
failure_log="/private/tmp/tirosh-vitalserver-postinstall-failure.log"
max_log_bytes=$((10 * 1024 * 1024))
keep_log_count=5
labels=(
  "com.tirosh.vitalserver-watchdog"
  "com.tirosh.vitalserver-guest-log-sync"
  "com.tirosh.vitalserver-proxy"
  "com.tirosh.vitalserver-vm"
  "com.tirosh.vitalserver-sleep-prevention"
)

mkdir -p "$(dirname "${install_log}")"

rotate_install_log() {
  [ -f "${install_log}" ] || return 0
  [ "$(stat -f%z "${install_log}")" -lt "${max_log_bytes}" ] && return 0

  local index source destination
  for ((index = keep_log_count - 1; index >= 1; index--)); do
    source="${install_log}.${index}"
    destination="${install_log}.$((index + 1))"
    [ -f "${destination}" ] && rm -f "${destination}"
    [ -f "${source}" ] && mv "${source}" "${destination}"
  done
  mv "${install_log}" "${install_log}.1"
}

rotate_install_log
exec > >(tee -a "${install_log}") 2>&1

log() {
  printf "[%s] %s\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*"
}

on_error() {
  local status="$?"
  log "postinstall failed status=${status} command=${BASH_COMMAND}"
  preserve_failure_log
  cleanup_failed_fresh_install
  exit "${status}"
}

trap on_error ERR

preserve_failure_log() {
  if [ -f "${install_log}" ]; then
    cp -p "${install_log}" "${failure_log}" 2>/dev/null || true
    log "postinstall failure log preserved path=${failure_log}"
  fi
}

cleanup_failed_fresh_install() {
  log "postinstall failure cleanup started"
  trap - ERR
  set +e

  local label
  for label in "${labels[@]}"; do
    launchctl bootout "system/${label}" >/dev/null 2>&1
  done

  stop_packaged_nginx

  rm -rf \
    "${product_root}" \
    "${manager_app}" \
    "${vm_bin}" \
    "${proxy_run}" \
    "${uninstaller}" \
    /Library/LaunchDaemons/com.tirosh.vitalserver*.plist
  pkgutil --forget com.tirosh.vitalserver.vm >/dev/null 2>&1
  pkgutil --forget com.tirosh.vitalserver >/dev/null 2>&1

  set -e
  trap on_error ERR
  log "postinstall failure cleanup completed"
}

stop_packaged_nginx() {
  local pid pids remaining

  pid=""
  if [ -s "${nginx_prefix}/logs/nginx.pid" ]; then
    pid="$(cat "${nginx_prefix}/logs/nginx.pid" 2>/dev/null || true)"
  fi
  if [ -n "${pid}" ] && kill -0 "${pid}" >/dev/null 2>&1; then
    log "postinstall failure cleanup stopping packaged nginx pid=${pid}"
    "${nginx_bin}" -p "${nginx_prefix}" -c "${nginx_prefix}/vitalserver.conf" -s quit >/dev/null 2>&1 || true
    sleep 1
  fi

  if command -v pgrep >/dev/null 2>&1; then
    pids="$(pgrep -f "${nginx_prefix}/sbin/nginx" | paste -sd" " - || true)"
    if [ -n "${pids}" ]; then
      log "postinstall failure cleanup terminating packaged nginx pids=${pids}"
      kill -TERM ${pids} >/dev/null 2>&1 || true
      sleep 1
      remaining="$(pgrep -f "${nginx_prefix}/sbin/nginx" | paste -sd" " - || true)"
      if [ -n "${remaining}" ]; then
        log "postinstall failure cleanup killing packaged nginx pids=${remaining}"
        kill -KILL ${remaining} >/dev/null 2>&1 || true
      fi
    fi
  fi
}

log "Tirosh VitalServer postinstall started"
if [ ! -d "${manager_app}" ]; then
  log "helper app missing path=${manager_app}"
  exit 1
fi
VITALSERVER_VM_HOME="${vm_home}" "${vm_bin}" runtime install-provision
log "Tirosh VitalServer postinstall completed"
