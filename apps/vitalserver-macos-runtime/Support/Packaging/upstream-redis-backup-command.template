#!/usr/bin/env bash
set -Eeuo pipefail

log_dir="${TMPDIR:-/private/tmp}"
log_file="${log_dir%/}/tirosh-vitalserver-upstream-redis-backup.log"
archive_name="redis-upstream-import.tar.gz"
script_dir="$(cd "$(dirname "$0")" && pwd)"
redis_save_bin="${script_dir}/bin/vitalserver-troubleshooting-upstream-redis-save"
redis_save_timeout_seconds="${UPSTREAM_REDIS_SAVE_TIMEOUT_SECONDS:-15}"

mkdir -p "${log_dir}"
exec > >(tee -a "${log_file}") 2>&1

log() {
  printf "[%s] %s\n" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*"
}

on_error() {
  local status="$?"
  log "upstream redis backup failed status=${status} command=${BASH_COMMAND}"
  exit "${status}"
}

trap on_error ERR

choose_folder() {
  local prompt="$1"
  /usr/bin/osascript -e "POSIX path of (choose folder with prompt \"${prompt}\")"
}

run_with_timeout() {
  local timeout_seconds="$1"
  shift
  local timeout_marker
  timeout_marker="$(/usr/bin/mktemp "${TMPDIR:-/private/tmp}/tirosh-upstream-redis-save-timeout.XXXXXX")"
  /bin/rm -f "${timeout_marker}"

  "$@" &
  local child_pid="$!"
  (
    /bin/sleep "${timeout_seconds}"
    if /bin/kill -0 "${child_pid}" 2>/dev/null; then
      : > "${timeout_marker}"
      log "upstream redis SAVE timed out after ${timeout_seconds}s; terminating helper pid=${child_pid}"
      /bin/kill "${child_pid}" 2>/dev/null || true
      /bin/sleep 1
      /bin/kill -9 "${child_pid}" 2>/dev/null || true
    fi
  ) &
  local watchdog_pid="$!"

  local status
  set +e
  wait "${child_pid}"
  status="$?"
  set -e
  /bin/kill "${watchdog_pid}" 2>/dev/null || true
  wait "${watchdog_pid}" 2>/dev/null || true

  if [ -f "${timeout_marker}" ]; then
    /bin/rm -f "${timeout_marker}"
    return 124
  fi
  /bin/rm -f "${timeout_marker}"
  return "${status}"
}

run_redis_save() {
  local target="$1"

  if [ -z "${target}" ]; then
    target="redis://127.0.0.1:6379"
  fi

  if [ ! -x "${redis_save_bin}" ]; then
    log "bundled upstream redis SAVE helper is missing or not executable: ${redis_save_bin}"
    exit 9
  fi

  case "${redis_save_timeout_seconds}" in
    ''|*[!0-9]*)
      log "invalid upstream redis SAVE timeout seconds: ${redis_save_timeout_seconds}"
      exit 10
      ;;
    0)
      log "invalid upstream redis SAVE timeout seconds: ${redis_save_timeout_seconds}"
      exit 10
      ;;
  esac

  log "upstream redis SAVE started timeoutSeconds=${redis_save_timeout_seconds}"
  if run_with_timeout "${redis_save_timeout_seconds}" "${redis_save_bin}" "${target}"; then
    :
  else
    local status="$?"
    if [ "${status}" -eq 124 ]; then
      log "upstream redis SAVE did not complete before timeout; rerun with skip or a reachable Redis URL"
    else
      log "upstream redis SAVE failed status=${status}"
    fi
    exit 10
  fi
  log "upstream redis SAVE completed"
}

prepare_dump() {
  printf "\nThis tool creates a Redis-only archive for VitalServer Helper import.\n"
  printf "The selected folder must be the Redis data directory that contains dump.rdb.\n\n"
  printf "This tool can refresh dump.rdb by running Redis SAVE before archiving.\n"
  printf "SAVE does not stop Redis, but Redis may briefly block while writing dump.rdb.\n"
  printf "SAVE is cancelled if Redis does not respond within ${redis_save_timeout_seconds}s.\n"
  printf "Redis URL [Enter: redis://127.0.0.1:6379, type skip to skip]: "
  local redis_target
  read -r redis_target
  case "${redis_target}" in
    [Ss][Kk][Ii][Pp])
      log "upstream redis SAVE skipped by user"
      ;;
    *)
      run_redis_save "${redis_target}"
      ;;
  esac
}

validate_source_dir() {
  local source_dir="$1"
  if [ ! -d "${source_dir}" ]; then
    log "upstream redis data directory is missing: ${source_dir}"
    exit 3
  fi
  if [ ! -f "${source_dir}/dump.rdb" ]; then
    log "upstream redis data directory does not contain dump.rdb: ${source_dir}"
    exit 4
  fi
  local first_link
  first_link="$(/usr/bin/find "${source_dir}" -type l -print -quit)"
  if [ -n "${first_link}" ]; then
    log "upstream redis data directory contains unsupported symlink: ${first_link}"
    exit 5
  fi
}

create_archive() {
  local source_dir="$1"
  local output_dir="$2"
  local archive="${output_dir%/}/${archive_name}"

  if [ ! -d "${output_dir}" ]; then
    log "output directory is missing: ${output_dir}"
    exit 6
  fi
  if [ -e "${archive}" ]; then
    log "refusing to overwrite existing archive: ${archive}"
    exit 7
  fi

  log "upstream redis archive started source=${source_dir} archive=${archive}"
  COPYFILE_DISABLE=1 COPY_EXTENDED_ATTRIBUTES_DISABLE=1 \
    /usr/bin/tar -czf "${archive}" -C "${source_dir}" .
  if [ ! -s "${archive}" ]; then
    log "upstream redis archive is empty: ${archive}"
    exit 8
  fi
  /usr/bin/tar -tzf "${archive}" >/dev/null
  log "upstream redis archive completed archive=${archive}"
}

log "upstream redis backup command started"
log "upstream redis backup log=${log_file}"
prepare_dump
source_dir="$(choose_folder "Choose the upstream Redis data directory that contains dump.rdb")"
output_dir="$(choose_folder "Choose where to save ${archive_name}")"
validate_source_dir "${source_dir}"
create_archive "${source_dir}" "${output_dir}"
log "upstream redis backup command completed"
