#!/usr/bin/env bash
set -euo pipefail

product_root="/Library/Application Support/TiroshVitalServer"
vm_home="${product_root}/vm"
script_dir="$(cd "$(dirname "$0")" && pwd)"
preflight_bin="${script_dir}/vitalserver-vm-preinstall"

fail_fresh_install_only() {
  echo "Tirosh VitalServer pkg install supports fresh installs only." >&2
  echo "Run a clean uninstall, stop the conflicting process, or choose a different Host proxy port before installing this pkg." >&2
  exit 1
}

if [ ! -x "${preflight_bin}" ]; then
  echo "fresh install preflight unavailable: ${preflight_bin}" >&2
  fail_fresh_install_only
fi

if ! VITALSERVER_VM_HOME="${vm_home}" "${preflight_bin}" runtime preinstall-check; then
  fail_fresh_install_only
fi
