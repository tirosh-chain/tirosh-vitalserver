{
  "channel": "dev",
  "helperVersion": "0.2.0",
  "releaseLabel": "0.2.0-dev",
  "minUpdaterVersion": "0.1.15",
  "targetPlatform": "macos-arm64",
  "distribution": {
    "profile": "dev",
    "audience": "internal"
  },
  "bundle": {
    "optionalContainerServices": []
  },
  "vitalServerVersion": "2.3.4",
  "services": {
    "vitalServer": {
      "displayName": "VitalServer",
      "image": "vitalserver:2.3.4",
      "version": "2.3.4"
    },
    "recorderIngress": {
      "displayName": "Recorder ingress",
      "image": "vitalserver-recorder-ingress:0.2.0",
      "version": "0.2.0"
    },
    "recorderRecovery": {
      "displayName": "Recorder recovery",
      "image": "vitalserver-recorder-recovery:0.2.0",
      "version": "0.2.0"
    },
    "vitalDBObserver": {
      "displayName": "VitalDB observer",
      "image": "vitaldb-observer:0.2.0",
      "version": "0.2.0"
    },
    "redisRelay": {
      "displayName": "Redis Relay",
      "image": "vitalserver-redis-relay:0.2.0",
      "version": "0.2.0"
    },
    "lab": {
      "displayName": "Lab",
      "image": "vitalserver-lab:0.2.0",
      "version": "0.2.0"
    },
    "redis": {
      "displayName": "Redis",
      "image": "redis:3.2.12-alpine",
      "version": "3.2.12"
    },
    "postgres": {
      "displayName": "Postgres",
      "image": "postgres:16-alpine",
      "version": "16"
    },
    "redisUI": {
      "displayName": "Redis UI",
      "image": "ghcr.io/joeferner/redis-commander:0.9.0",
      "version": "0.9.0"
    },
    "swaggerUI": {
      "displayName": "Swagger UI",
      "image": "swaggerapi/swagger-ui:v5.17.14",
      "version": "5.17.14"
    },
    "guestEdge": {
      "displayName": "Guest edge proxy",
      "image": "nginx:1.24-alpine",
      "version": "1.24"
    },
    "hostProxy": {
      "displayName": "Network access",
      "image": "nginx/1.31.1",
      "version": "1.31.1"
    }
  }
}
