<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.tirosh.vitalserver.helper.update-handoff-supervisor</string>

  <key>ProgramArguments</key>
  <array>
    <string>${VITALSERVER_UPDATE_HANDOFF_SUPERVISOR_BIN}</string>
    <string>serve</string>
    <string>--root</string>
    <string>${VITALSERVER_UPDATE_HANDOFF_JOBS}</string>
    <string>--interval-ms</string>
    <string>250</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>${VITALSERVER_RUNTIME_LOGS}/update-handoff-supervisor.out.log</string>

  <key>StandardErrorPath</key>
  <string>${VITALSERVER_RUNTIME_LOGS}/update-handoff-supervisor.err.log</string>
</dict>
</plist>
