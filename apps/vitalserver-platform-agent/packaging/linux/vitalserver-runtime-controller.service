[Unit]
Description=VitalServer Runtime Controller
After=network-online.target vitalserver-runtime-provider.service
Wants=network-online.target
RequiresMountsFor=/var/lib/vitalserver

[Service]
Type=simple
WorkingDirectory=/opt/vitalserver/current/runtime-bundle
Environment=VITALSERVER_RUNTIME_CONTROLLER_SETTINGS_PATH=/etc/vitalserver/runtime-controller.toml
EnvironmentFile=/etc/vitalserver/runtime.env
ExecStartPre=/opt/vitalserver/current/runtime-controller/venv/bin/tirosh-guest-tools-migrate-control-store
ExecStart=/opt/vitalserver/current/runtime-controller/venv/bin/tirosh-vitalserver-guest-control-api --host 127.0.0.1 --port 18330 --redis-relay-status-owner-socket /var/lib/vitalserver/run/redis-relay-status-owner.sock
Restart=on-failure
RestartSec=5
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/vitalserver /opt/vitalserver
ReadWritePaths=/etc/vitalserver/runtime-config.json /etc/vitalserver/runtime-settings.json /etc/vitalserver/redis-relay/redis-relay.toml /etc/vitalserver/secrets/redis-relay /var/lib/vitalserver /var/log/vitalserver /run/docker.sock

[Install]
WantedBy=multi-user.target
