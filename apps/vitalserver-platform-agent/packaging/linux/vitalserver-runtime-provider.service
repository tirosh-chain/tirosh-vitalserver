[Unit]
Description=VitalServer Linux Native Runtime Provider
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target vitalserver-runtime-controller.service

[Service]
Type=simple
ExecStart=/opt/vitalserver/current/bin/vitalserver-runtime-provider --config /etc/vitalserver/native-runtime-provider.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=150
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/vitalserver /opt/vitalserver
ReadWritePaths=/var/lib/vitalserver /var/log/vitalserver /run/docker.sock

[Install]
WantedBy=multi-user.target
