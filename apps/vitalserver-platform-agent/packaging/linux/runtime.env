VITALSERVER_VITAL_FILES_DIR=/var/lib/vitalserver/data/vital-files
VITALSERVER_VR_RELEASE_DIR=/opt/vitalserver/current/runtime-bundle/vr-release
VITALSERVER_RECORDER_INGRESS_RAW_DIR=/var/lib/vitalserver/data/recorder-ingress/raw
VITALSERVER_RECORDER_INGRESS_RECOVERY_DIR=/var/lib/vitalserver/data/recorder-ingress/recovery
VITALSERVER_RECORDER_INGRESS_FAILURES_DIR=/var/lib/vitalserver/data/recorder-ingress/failures
VITALSERVER_REDIS_RELAY_CONFIG_DIR=/etc/vitalserver/redis-relay
VITALSERVER_REDIS_RELAY_SECRETS_DIR=/etc/vitalserver/secrets/redis-relay
VITALSERVER_REDIS_RELAY_STATUS_DIR=/var/lib/vitalserver/run/redis-relay-status
VITALSERVER_RUNTIME_RUN_DIR=/var/lib/vitalserver/run
REDIS_RELAY_STATUS_OWNER_SOCKET=/run/tirosh/status-owner/redis-relay-status-owner.sock
REDIS_RELAY_STATUS_OWNER_URL=
VITALSERVER_DOCS_DIR=/opt/vitalserver/current/runtime-bundle/docs
VITALSERVER_OPENAPI_PATH=/opt/vitalserver/current/runtime-bundle/docs/openapi.yaml
VITALSERVER_NGINX_CONFIG_PATH=/opt/vitalserver/current/runtime-bundle/nginx/vitalserver.conf
