{
  "name": "@tirosh/vitalserver-recorder-ingress",
  "version": "0.1.0",
  "private": true,
  "description": "VitalServer recorder ingress, Socket.IO audit, and edge-observation sidecar",
  "type": "commonjs",
  "main": "proxy.js",
  "scripts": {
    "start": "node proxy.js",
    "test": "find tests -name '*.test.js' -print | sort | xargs node --test",
    "test:unit": "find tests/unit -name '*.test.js' -print | sort | xargs node --test",
    "test:integration": "find tests/integration -name '*.test.js' -print | sort | xargs node --test",
    "check": "find . -name '*.js' -print -exec node --check {} \\;"
  },
  "engines": {
    "node": ">=20"
  }
}
