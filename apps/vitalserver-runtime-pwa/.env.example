# Browser-visible Runtime Control settings must use the VITE_ prefix.
VITE_RUNTIME_CONTROL_API_BASE_URL=
# Leave this empty for the installed same-origin PWA. The Platform Agent issues
# a short-lived HttpOnly browser session instead of embedding its owner token.
# Set a development-only token only when working through a separately configured API.
VITE_RUNTIME_CONTROL_TOKEN=
VITE_RUNTIME_CONTROL_DEFAULT_PORT=18321
VITE_RUNTIME_CONTROL_DEFAULT_PROXY_PORT=80

# Vite dev server settings. Unprefixed aliases are also accepted by vite.config.ts.
VITE_RUNTIME_CONTROL_DEV_PROXY_TARGET=http://127.0.0.1:18321
VITE_PWA_DEV_SERVER_PORT=5174
VITE_PWA_PREVIEW_PORT=4174

# React Query defaults.
VITE_QUERY_REFETCH_ON_WINDOW_FOCUS=false
VITE_QUERY_RETRY=1
VITE_QUERY_STALE_TIME_MS=1000
