{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:guest-runtime-control-endpoint",
  "title": "GuestRuntimeControlEndpoint",
  "description": "The Host Agent-owned configured Guest Runtime Control HTTP target together with independent Platform Provider and Runtime Control transport observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "resourceRevision",
    "address",
    "provider",
    "transport",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "resourceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "address": {
      "$ref": "#/$defs/ConfiguredGuestRuntimeControlHTTPAddress"
    },
    "provider": {
      "$ref": "#/$defs/PlatformProviderObservation"
    },
    "transport": {
      "$ref": "#/$defs/GuestRuntimeControlTransportObservation"
    },
    "createdAt": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
    },
    "updatedAt": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ConfiguredGuestRuntimeControlHTTPAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "host",
        "port"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "PlatformProviderObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "state",
        "observedAt"
      ],
      "properties": {
        "kind": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "id": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "state": {
          "type": "string",
          "enum": [
            "not-observed",
            "starting",
            "running",
            "stopping",
            "stopped",
            "unavailable",
            "failed"
          ]
        },
        "observedAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        },
        "issue": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "unavailable",
                  "failed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "issue"
            ]
          },
          "else": {
            "not": {
              "required": [
                "issue"
              ]
            }
          }
        }
      ]
    },
    "GuestRuntimeControlTransportObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observedAt"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not-checked",
            "reachable",
            "unavailable",
            "failed"
          ]
        },
        "observedAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        },
        "issue": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "unavailable",
                  "failed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "issue"
            ]
          },
          "else": {
            "not": {
              "required": [
                "issue"
              ]
            }
          }
        }
      ]
    }
  }
}
