{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:product-update-specification",
  "title": "ProductUpdateSpecification",
  "description": "C26 evolving, next-updater-only layer specification. It is authenticated by the C25 digest but is intentionally not interpreted by the previously installed Host updater.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "bootstrapEnvelopeId", "layerPlan"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "bootstrapEnvelopeId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "layerPlan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/LayerPlan" }
    }
  },
  "$defs": {
    "LayerPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "dependsOn", "artifact", "rollback"],
      "properties": {
        "layer": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:update-bootstrap-envelope#/$defs/UpdateLayer" },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:update-bootstrap-envelope#/$defs/UpdateLayer" }
        },
        "artifact": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:update-bootstrap-envelope#/$defs/Artifact" },
        "rollback": { "$ref": "#/$defs/RollbackPlan" }
      }
    },
    "RollbackPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["available", "unsupported"] },
        "artifact": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:update-bootstrap-envelope#/$defs/Artifact" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "available" } }, "required": ["state"] },
          "then": { "required": ["artifact"], "not": { "required": ["reason"] } },
          "else": { "required": ["reason"], "not": { "required": ["artifact"] } }
        }
      ]
    }
  }
}
