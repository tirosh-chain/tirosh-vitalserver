{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:guest-archive-credential-material-provisioning-outcome",
  "title": "GuestArchiveCredentialMaterialProvisioningOutcome",
  "description": "Immediate non-secret result of accepting one C51 document through the OS-authorized Host Agent local-administration facade. It is not a durable operation or receipt and contains no C51 userId, password, bytes, digest, or path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "observedAt"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "state": { "enum": ["provisioned", "rejected", "failed"] },
    "observedAt": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp" },
    "credentialReference": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SecretReference" },
    "issue": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "provisioned" } }, "required": ["state"] },
      "then": {
        "required": ["credentialReference"],
        "not": { "required": ["issue"] }
      },
      "else": { "required": ["issue"] }
    }
  ]
}
