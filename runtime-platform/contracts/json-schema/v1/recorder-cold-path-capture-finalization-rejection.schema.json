{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:recorder-cold-path-capture-finalization-rejection",
  "title": "RecorderColdPathCaptureFinalizationRejection",
  "description": "A Recorder Gateway-owned non-admission result for a cold-path capture finalization command. requestId is absent when no valid command identity was supplied; the Gateway never invents one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state",
    "issue"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "state": {
      "const": "rejected"
    },
    "requestId": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "issue": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue"
    }
  }
}
