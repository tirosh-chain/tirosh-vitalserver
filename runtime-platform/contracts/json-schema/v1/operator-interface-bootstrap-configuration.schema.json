{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:operator-interface-bootstrap-configuration",
  "title": "OperatorInterfaceBootstrapConfiguration",
  "description": "C53 Host installation-owned configuration passed explicitly to a packaged Runtime Console launcher. It names the Host Agent-owned C52 descriptor path only; it is not Host Agent deployment input, authorization policy, a remote endpoint, or runtime state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bootstrapConfigurationPath", "localAdministrationDescriptorPath"],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "bootstrapConfigurationPath": {
      "$ref": "#/$defs/SafeHostAbsolutePath"
    },
    "localAdministrationDescriptorPath": {
      "$ref": "#/$defs/SafeHostAbsolutePath"
    }
  },
  "$defs": {
    "SafeHostAbsolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "anyOf": [
        {
          "pattern": "^/[^\\\\]*$",
          "not": { "pattern": "(^|/)\\.\\.(/|$)" }
        },
        {
          "pattern": "^[A-Za-z]:[\\\\/][^\\u0000]*$",
          "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" }
        }
      ]
    }
  }
}
