{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:telemetry-correlation",
  "title": "TelemetryCorrelation",
  "description": "A safe correlation envelope for OpenTelemetry logs, metrics, and traces. It is diagnostic evidence, not product state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "service",
    "signalKinds",
    "signalName",
    "emittedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "service": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ServiceIdentity"
    },
    "signalKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "logs",
          "metrics",
          "traces"
        ]
      }
    },
    "signalName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "emittedAt": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
    },
    "requestId": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "operationId": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "component": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "outcomeCode": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    }
  }
}
