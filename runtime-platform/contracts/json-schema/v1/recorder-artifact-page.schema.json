{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:recorder-artifact-page",
  "title": "RecorderArtifactPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recorderId",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "recorderId": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:archive-artifact-detail"
      }
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
