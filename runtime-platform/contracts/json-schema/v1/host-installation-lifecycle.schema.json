{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:host-installation-lifecycle",
  "title": "HostInstallationRequest, HostInstallationJournal, and HostInstallationReceipt",
  "description": "C50 Host Installation Manager-owned install command, durable transaction state, and receipt language. It distinguishes side-effect-free preflight, durable service quiescence intent, activation, service finalization, and explicit recovery. It never makes a direct version-changing package install an implicit update.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Journal"
    },
    {
      "$ref": "#/$defs/Receipt"
    }
  ],
  "$defs": {
    "Issue": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue"
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "documentKind",
        "id",
        "installationId",
        "operation",
        "expectedReleaseId",
        "requestedAt"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
        },
        "documentKind": {
          "const": "host-installation-request"
        },
        "id": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "installationId": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "operation": {
          "type": "string",
          "enum": [
            "preflight",
            "quiesce-services",
            "activate-release",
            "finalize-services",
            "recover-installation"
          ]
        },
        "packageManagerOperation": {
          "description": "Optional explicit package-manager phase supplied by a package transport. Only a platform-specific Host Installation Manager transition may consume it; absence is not a default phase.",
          "type": "string",
          "enum": [
            "windows-msi-installing"
          ]
        },
        "expectedReleaseId": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "requestedAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        }
      }
    },
    "Journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "documentKind",
        "id",
        "requestId",
        "installationId",
        "releaseId",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
        },
        "documentKind": {
          "const": "host-installation-journal"
        },
        "id": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "requestId": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "installationId": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "releaseId": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "state": {
          "type": "string",
          "enum": [
            "preflight-verified",
            "services-quiescing",
            "activation-pending",
            "activated",
            "completed",
            "recovered",
            "failed"
          ]
        },
        "failure": {
          "$ref": "#/$defs/Issue"
        },
        "createdAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "failure"
            ]
          },
          "else": {
            "not": {
              "required": [
                "failure"
              ]
            }
          }
        }
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "documentKind",
        "id",
        "requestId",
        "installationId",
        "releaseId",
        "state",
        "observedAt"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
        },
        "documentKind": {
          "const": "host-installation-receipt"
        },
        "id": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "requestId": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "installationId": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "releaseId": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "state": {
          "type": "string",
          "enum": [
            "preflight-admitted",
            "services-quiesced",
            "activated",
            "completed",
            "recovered",
            "blocked",
            "failed"
          ]
        },
        "issue": {
          "$ref": "#/$defs/Issue"
        },
        "observedAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "blocked",
                  "failed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "issue"
            ]
          },
          "else": {
            "not": {
              "required": [
                "issue"
              ]
            }
          }
        }
      ]
    }
  }
}
