{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:guest-archive-credential-material-availability",
  "title": "GuestArchiveCredentialMaterialAvailability",
  "description": "Non-secret C51 availability projection returned only through the OS-authorized Host Agent local-administration facade. It identifies the C46 credential reference but never includes C51 userId, password, material bytes, digest, path, or filesystem detail.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "observedAt"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "state": { "enum": ["available", "missing", "invalid", "failed"] },
    "observedAt": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp" },
    "credentialReference": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SecretReference" },
    "issue": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "available" } }, "required": ["state"] },
      "then": {
        "required": ["credentialReference"],
        "not": { "required": ["issue"] }
      },
      "else": { "required": ["issue"] }
    },
    {
      "if": { "properties": { "state": { "enum": ["missing", "invalid"] } }, "required": ["state"] },
      "then": { "required": ["credentialReference"] }
    }
  ]
}
