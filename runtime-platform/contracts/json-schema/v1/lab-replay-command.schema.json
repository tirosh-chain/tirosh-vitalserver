{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:lab-replay-command",
  "title": "LabReplayCommand",
  "description": "Admits one durable replay operation for an already admitted immutable Lab replay source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "replayId", "sourceReference", "sourceSha256", "recorderGatewayRecorderCode", "requestedAt"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "requestId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "replayId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "sourceReference": { "$ref": "#/$defs/LabReplaySourceReference" },
    "sourceSha256": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Sha256" },
    "recorderGatewayRecorderCode": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "requestedAt": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp" }
  },
  "$defs": {
    "LabReplaySourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "resourceId"],
      "properties": {
        "resourceType": { "const": "lab-replay-source" },
        "resourceId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" }
      }
    }
  }
}
