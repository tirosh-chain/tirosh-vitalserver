{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:vital-replay-corpus-manifest",
  "title": "VitalReplayCorpusManifest",
  "description": "Release-process declaration of human-approved, non-identifying, redistribution-authorized Recorder .vital artifacts used for v1-v3 replay compatibility evidence. The declaration does not itself prove the selected bytes; the corpus verifier binds every entry to an exact regular file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusId",
    "approval",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "corpusId": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewer",
        "reviewedAt",
        "evidenceReference",
        "assertions"
      ],
      "properties": {
        "decision": {
          "const": "approved"
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "human"
            },
            "id": {
              "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
            }
          }
        },
        "reviewedAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        },
        "evidenceReference": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/EvidenceReference"
        },
        "assertions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nonIdentifying",
            "redistributionAuthorized",
            "clinicalUseProhibited"
          ],
          "properties": {
            "nonIdentifying": {
              "const": true
            },
            "redistributionAuthorized": {
              "const": true
            },
            "clinicalUseProhibited": {
              "const": true
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/CorpusEntry"
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "entries": {
          "contains": {
            "type": "object",
            "properties": {
              "formatVersion": {
                "const": 1
              }
            },
            "required": [
              "formatVersion"
            ]
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "entries": {
          "contains": {
            "type": "object",
            "properties": {
              "formatVersion": {
                "const": 2
              }
            },
            "required": [
              "formatVersion"
            ]
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "entries": {
          "contains": {
            "type": "object",
            "properties": {
              "formatVersion": {
                "const": 3
              }
            },
            "required": [
              "formatVersion"
            ]
          },
          "minContains": 1
        }
      }
    }
  ],
  "$defs": {
    "CorpusEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fileName",
        "byteSize",
        "sha256",
        "formatVersion",
        "origin",
        "expectedReplay"
      ],
      "properties": {
        "id": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,1017}\\.vital$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Sha256"
        },
        "formatVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidenceReference"
          ],
          "properties": {
            "kind": {
              "enum": [
                "nonclinical-recorder-export",
                "deidentified-recorder-export"
              ]
            },
            "evidenceReference": {
              "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/EvidenceReference"
            }
          }
        },
        "expectedReplay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "minimumGraphCompatibleSignalCount",
            "trackKinds"
          ],
          "properties": {
            "outcome": {
              "const": "succeeded"
            },
            "minimumGraphCompatibleSignalCount": {
              "type": "integer",
              "minimum": 1
            },
            "trackKinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "waveform",
                  "numeric",
                  "string"
                ]
              }
            }
          }
        }
      }
    }
  }
}
