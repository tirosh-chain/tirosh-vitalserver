{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:read-result",
  "title": "ReadResult",
  "description": "An explicit owner read outcome. Consumers must not infer an available value from any other state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "state": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ReadState"
    },
    "observedAt": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
    },
    "value": {
      "not": {
        "type": "null"
      }
    },
    "issue": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue"
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 0
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/EvidenceReference"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "available"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "not": {
          "required": [
            "issue"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "empty"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "issue"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "missing",
              "invalid",
              "unavailable",
              "failed",
              "stale",
              "unsupported"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "issue"
        ],
        "not": {
          "required": [
            "value"
          ]
        }
      }
    }
  ]
}
