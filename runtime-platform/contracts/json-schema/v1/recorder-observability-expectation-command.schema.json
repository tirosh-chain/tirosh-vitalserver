{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:recorder-observability-expectation-command",
  "title": "RecorderObservabilityExpectationCommand",
  "description": "An explicit revisioned operator declaration. Absence of a report never creates this command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "expectedResourceRevision", "action", "evidence"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "requestId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "expectedResourceRevision": { "type": "integer", "minimum": 0 },
    "action": { "type": "string", "enum": ["set", "clear"] },
    "expectationState": { "type": "string", "enum": ["expected", "not-expected"] },
    "supportState": { "type": "string", "enum": ["supported", "unsupported"] },
    "source": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "evidence": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "set" } }, "required": ["action"] },
      "then": { "required": ["expectationState", "source"] }
    },
    {
      "if": { "properties": { "action": { "const": "clear" } }, "required": ["action"] },
      "then": {
        "properties": { "evidence": { "maxProperties": 0 } },
        "not": {
          "anyOf": [
            { "required": ["expectationState"] },
            { "required": ["supportState"] },
            { "required": ["source"] },
            { "required": ["reason"] }
          ]
        }
      }
    }
  ]
}
