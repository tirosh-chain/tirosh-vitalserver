{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:provider-lifecycle-request",
  "title": "ProviderLifecycleRequest",
  "description": "A Host Agent-to-provider effect request. The provider receives only an explicit action and does not own Host workflow transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "providerId",
    "action"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "requestId": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "providerId": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "action": {
      "type": "string",
      "enum": [
        "start",
        "stop",
        "reboot"
      ]
    }
  }
}
