{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:guest-product-vitalserver-topology-deployment",
  "title": "GuestProductVitalServerTopologyDeployment",
  "description": "C44 Guest Product release-author desired topology for Recorder Gateway VitalServer packet delivery and optional browser exposure. It selects bundled or external placement and preserves every required artifact or integration reference. It is not a connection, process, packet-delivery, or clinical-state observation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "topologyDeploymentId", "topologyKind", "vitalServerDeliveryProvider", "publicBrowserExposure"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "topologyDeploymentId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "topologyKind": { "enum": ["bundled-vitalserver", "external-vitalserver"] },
    "vitalServerDeliveryProvider": { "$ref": "#/$defs/VitalServerDeliveryProvider" },
    "publicBrowserExposure": { "enum": ["not-exposed", "guest-virtio-route", "host-external-route"] },
    "bundledUpstreamImageSetDeployment": { "$ref": "#/$defs/BundledUpstreamImageSetDeployment" },
    "externalVitalServerDeploymentConfiguration": { "$ref": "#/$defs/ExternalVitalServerDeploymentConfiguration" }
  },
  "allOf": [
    {
      "if": { "properties": { "topologyKind": { "const": "bundled-vitalserver" } }, "required": ["topologyKind"] },
      "then": {
        "required": ["bundledUpstreamImageSetDeployment"],
        "properties": {
          "publicBrowserExposure": { "enum": ["not-exposed", "guest-virtio-route"] },
          "vitalServerDeliveryProvider": {
            "properties": { "kind": { "const": "bundled-vitalserver" } },
            "required": ["kind"]
          }
        },
        "not": { "required": ["externalVitalServerDeploymentConfiguration"] }
      }
    },
    {
      "if": { "properties": { "topologyKind": { "const": "external-vitalserver" } }, "required": ["topologyKind"] },
      "then": {
        "required": ["externalVitalServerDeploymentConfiguration"],
        "properties": { "publicBrowserExposure": { "enum": ["not-exposed", "host-external-route"] } },
        "not": { "required": ["bundledUpstreamImageSetDeployment"] }
      }
    }
  ],
  "$defs": {
    "AbsoluteGuestPath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1024,
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "GuestLoopbackListener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindHost", "port"],
      "properties": {
        "bindHost": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "VitalServerDeliveryProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "capabilityRevision"],
      "properties": {
        "kind": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "capabilityRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "BundledUpstreamImageSetDeployment": {
      "description": "Required desired facts for a C64-owned VitalServer/Redis image set. C44 names the Guest-loopback packet, observation, and indexed-library archive endpoints together with the C64 configuration resource, but never claims that C64 loaded images, Docker started a container, or any endpoint is reachable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["imageSetManagerConfigurationReference", "vitalServerPacketDeliveryEndpoint", "vitalServerDeliveryAcknowledgementTimeoutMilliseconds", "vitalServerObservationEndpoint", "vitalServerArchiveProvider", "vitalServerIndexedLibraryEndpoint", "vitalServerArchiveCredentialReference", "vitalServerArchiveRequestTimeoutMilliseconds"],
      "properties": {
        "imageSetManagerConfigurationReference": {
          "allOf": [
            { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ResourceReference" },
            { "properties": { "resourceType": { "const": "guest-bundled-upstream-image-set-manager-configuration" } }, "required": ["resourceType"] }
          ]
        },
        "vitalServerPacketDeliveryEndpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "host", "port"],
          "properties": {
            "scheme": { "const": "http" },
            "host": { "const": "127.0.0.1" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "vitalServerDeliveryAcknowledgementTimeoutMilliseconds": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "vitalServerObservationEndpoint": { "$ref": "#/$defs/BundledVitalServerObservationEndpoint" },
        "vitalServerArchiveProvider": { "$ref": "#/$defs/VitalServerArchiveProvider" },
        "vitalServerIndexedLibraryEndpoint": { "$ref": "#/$defs/BundledVitalServerEndpoint" },
        "vitalServerArchiveCredentialReference": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SecretReference" },
        "vitalServerArchiveRequestTimeoutMilliseconds": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "VitalServerArchiveProvider": {
      "description": "The independent capability that uploads and verifies indexed .vital files. Packet delivery does not imply archive export.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "capabilityRevision"],
      "properties": {
        "kind": { "const": "vitalserver-indexed-library" },
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "capabilityRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "BundledVitalServerEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "port"],
      "properties": {
        "scheme": { "const": "http" },
        "host": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "BundledVitalServerObservationEndpoint": {
      "description": "The exact Guest-loopback health path exposed by the C64-managed Image-set. C44 does not claim that the path is reachable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "port", "path", "acceptedStatusCodes"],
      "properties": {
        "scheme": { "const": "http" },
        "host": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/[^?#]*$" },
        "acceptedStatusCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        }
      }
    },
    "ExternalVitalServerDeploymentConfiguration": {
      "description": "References, never endpoint or credential material. The selected external provider configuration resolves delivery material before Gateway activation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["externalUpstreamIntegrationReference", "externalVitalServerDeliveryConfigurationReference"],
      "properties": {
        "externalUpstreamIntegrationReference": {
          "allOf": [
            { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ResourceReference" },
            { "properties": { "resourceType": { "const": "external-upstream-integration" } }, "required": ["resourceType"] }
          ]
        },
        "externalVitalServerDeliveryConfigurationReference": {
          "allOf": [
            { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ResourceReference" },
            { "properties": { "resourceType": { "const": "external-vitalserver-delivery-configuration" } }, "required": ["resourceType"] }
          ]
        }
      }
    }
  }
}
