{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:guest-linux-boot-artifact-extraction-declaration",
  "title": "GuestLinuxBootArtifactExtractionDeclaration",
  "description": "C42 immutable release-build declaration for publishing one ARM64 Linux root filesystem, uncompressed kernel Image, and initial ramdisk as distinct identified release-build inputs. A boot resource is read either from the explicitly selected ext4 source filesystem or from its own identified external source artifact; it is never guessed from the root image. The source filesystem is either the entire raw disk or one explicitly numbered raw-disk partition. A QCOW2 source disk must first be materialized through C73. Build-machine paths never appear in the receipt or emitted artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "extractionId", "architecture", "sourceImage", "sourceFilesystem", "bootResources", "rootStorage"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "extractionId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "architecture": { "const": "arm64" },
    "sourceImage": { "$ref": "#/$defs/GuestLinuxSourceImage" },
    "sourceFilesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "filesystemType"],
      "properties": {
        "layout": { "enum": ["whole-disk-ext4", "partitioned-disk-ext4"] },
        "filesystemType": { "const": "ext4" },
        "partitionIndex": { "type": "integer", "minimum": 1, "maximum": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "layout": { "const": "partitioned-disk-ext4" } }, "required": ["layout"] },
          "then": { "required": ["partitionIndex"] },
          "else": { "not": { "required": ["partitionIndex"] } }
        }
      ]
    },
    "bootResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel", "initialRamdisk"],
      "properties": {
        "kernel": { "$ref": "#/$defs/GzipCompressedLinuxKernelExtraction" },
        "initialRamdisk": { "$ref": "#/$defs/UncompressedInitialRamdiskExtraction" }
      }
    },
    "rootStorage": { "$ref": "#/$defs/GuestRootStorageExtraction" }
  },
  "$defs": {
    "SourceAbsolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "GuestAbsolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1024,
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "BootOutputRelativePath": {
      "type": "string",
      "minLength": 6,
      "maxLength": 1024,
      "pattern": "^boot/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "StorageOutputRelativePath": {
      "type": "string",
      "minLength": 9,
      "maxLength": 1024,
      "pattern": "^storage/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "GuestLinuxSourceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceAbsolutePath", "sourceOriginUri", "sourceRelease", "sizeBytes", "sha256"],
      "properties": {
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "sourceAbsolutePath": { "$ref": "#/$defs/SourceAbsolutePath" },
        "sourceOriginUri": { "type": "string", "format": "uri", "maxLength": 4096 },
        "sourceRelease": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Sha256" },
        "sourceMaterialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receiptAbsolutePath", "receiptSHA256", "materializationId"],
          "properties": {
            "receiptAbsolutePath": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/" },
            "receiptSHA256": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Sha256" },
            "materializationId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" }
          }
        }
      }
    },
    "GzipCompressedLinuxKernelExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "sourceCompression", "outputRelativePath", "outputFormat"],
      "properties": {
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "source": { "$ref": "#/$defs/BootResourceSource" },
        "sourceCompression": { "const": "gzip" },
        "outputRelativePath": { "const": "boot/Image" },
        "outputFormat": { "const": "uncompressed-linux-arm64-image" }
      }
    },
    "UncompressedInitialRamdiskExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "sourceCompression", "outputRelativePath", "outputFormat"],
      "properties": {
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "source": { "$ref": "#/$defs/BootResourceSource" },
        "sourceCompression": { "const": "none" },
        "outputRelativePath": { "const": "boot/initrd.img" },
        "outputFormat": { "const": "cpio" }
      }
    },
    "BootResourceSource": {
      "oneOf": [
        { "$ref": "#/$defs/SourceImageFilesystemBootResource" },
        { "$ref": "#/$defs/ExternalArtifactBootResource" }
      ]
    },
    "SourceImageFilesystemBootResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "guestAbsolutePath"],
      "properties": {
        "kind": { "const": "source-image-filesystem" },
        "guestAbsolutePath": { "$ref": "#/$defs/GuestAbsolutePath" }
      }
    },
    "ExternalArtifactBootResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceAbsolutePath", "sourceOriginUri", "sourceRelease", "sizeBytes", "sha256"],
      "properties": {
        "kind": { "const": "external-artifact" },
        "sourceAbsolutePath": { "$ref": "#/$defs/SourceAbsolutePath" },
        "sourceOriginUri": { "type": "string", "format": "uri", "maxLength": 4096 },
        "sourceRelease": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Sha256" }
      }
    },
    "GuestRootStorageExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "guestDevicePath", "outputRelativePath", "filesystemType", "storageLayout"],
      "properties": {
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "guestDevicePath": { "const": "/dev/vda" },
        "outputRelativePath": { "$ref": "#/$defs/StorageOutputRelativePath" },
        "filesystemType": { "const": "ext4" },
        "storageLayout": { "const": "whole-disk-ext4" }
      }
    }
  }
}
