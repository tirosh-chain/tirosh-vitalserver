{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:guest-linux-boot-artifact-extraction-declaration",
  "title": "GuestLinuxBootArtifactExtractionDeclaration",
  "description": "C42 immutable release-build declaration for extracting one gzip-compressed ARM64 Linux kernel into the uncompressed Image consumed by the macOS Virtualization boot loader, copying the declared uncompressed initial ramdisk, and publishing one byte-identified whole-disk ext4 source image as the C35 root-storage source. sourceAbsolutePath is a build-machine-only input and must never appear in the receipt or emitted artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "extractionId", "architecture", "sourceImage", "sourceFilesystem", "bootResources", "rootStorage"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "extractionId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "architecture": { "const": "arm64" },
    "sourceImage": { "$ref": "#/$defs/GuestLinuxSourceImage" },
    "sourceFilesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "filesystemType"],
      "properties": {
        "layout": { "const": "whole-disk-ext4" },
        "filesystemType": { "const": "ext4" }
      }
    },
    "bootResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel", "initialRamdisk"],
      "properties": {
        "kernel": { "$ref": "#/$defs/GzipCompressedLinuxKernelExtraction" },
        "initialRamdisk": { "$ref": "#/$defs/UncompressedInitialRamdiskExtraction" }
      }
    },
    "rootStorage": { "$ref": "#/$defs/GuestRootStorageExtraction" }
  },
  "$defs": {
    "SourceAbsolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "GuestAbsolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1024,
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "BootOutputRelativePath": {
      "type": "string",
      "minLength": 6,
      "maxLength": 1024,
      "pattern": "^boot/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "StorageOutputRelativePath": {
      "type": "string",
      "minLength": 9,
      "maxLength": 1024,
      "pattern": "^storage/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "GuestLinuxSourceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceAbsolutePath", "sourceOriginUri", "sourceRelease", "sizeBytes", "sha256"],
      "properties": {
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "sourceAbsolutePath": { "$ref": "#/$defs/SourceAbsolutePath" },
        "sourceOriginUri": { "type": "string", "format": "uri", "maxLength": 4096 },
        "sourceRelease": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Sha256" }
      }
    },
    "GzipCompressedLinuxKernelExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "guestAbsolutePath", "sourceCompression", "outputRelativePath", "outputFormat"],
      "properties": {
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "guestAbsolutePath": { "$ref": "#/$defs/GuestAbsolutePath" },
        "sourceCompression": { "const": "gzip" },
        "outputRelativePath": { "const": "boot/Image" },
        "outputFormat": { "const": "uncompressed-linux-arm64-image" }
      }
    },
    "UncompressedInitialRamdiskExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "guestAbsolutePath", "sourceCompression", "outputRelativePath", "outputFormat"],
      "properties": {
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "guestAbsolutePath": { "$ref": "#/$defs/GuestAbsolutePath" },
        "sourceCompression": { "const": "none" },
        "outputRelativePath": { "const": "boot/initrd.img" },
        "outputFormat": { "const": "cpio" }
      }
    },
    "GuestRootStorageExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "guestDevicePath", "outputRelativePath", "filesystemType", "storageLayout"],
      "properties": {
        "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
        "guestDevicePath": { "const": "/dev/vda" },
        "outputRelativePath": { "$ref": "#/$defs/StorageOutputRelativePath" },
        "filesystemType": { "const": "ext4" },
        "storageLayout": { "const": "whole-disk-ext4" }
      }
    }
  }
}
