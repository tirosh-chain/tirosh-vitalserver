{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:deletion-receipt",
  "title": "DeletionReceipt",
  "description": "A Lab-owned immutable receipt that distinguishes resources deleted from Archive-owned artifacts deliberately retained by policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "operationId", "requestId", "target", "cascade", "deletedResources", "retainedResources", "completedAt"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "id": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "operationId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "requestId": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier" },
    "target": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ResourceReference" },
    "cascade": { "type": "string", "enum": ["none", "owned-resources"] },
    "deletedResources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ResourceReference" }
    },
    "retainedResources": {
      "type": "array",
      "items": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ResourceReference" }
    },
    "completedAt": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp" }
  }
}
