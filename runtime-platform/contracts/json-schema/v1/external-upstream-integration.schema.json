{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:external-upstream-integration",
  "title": "ExternalUpstreamIntegration",
  "description": "A Guest Runtime-owned configuration and explicit provider observation for an external VitalServer upstream. It contains references, never endpoint secrets or provider-private state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "resourceRevision",
    "spec",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "id": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
    },
    "resourceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "spec": {
      "$ref": "#/$defs/ExternalUpstreamSpec"
    },
    "status": {
      "$ref": "#/$defs/ExternalUpstreamStatus"
    },
    "createdAt": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
    },
    "updatedAt": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ProviderReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "capabilityRevision"
      ],
      "properties": {
        "kind": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "id": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Identifier"
        },
        "capabilityRevision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ExternalUpstreamSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "endpointReference"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderReference"
        },
        "endpointReference": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ResourceReference"
        },
        "credentialReference": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SecretReference"
        }
      }
    },
    "ConnectionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observedAt"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "reachable",
            "unavailable",
            "failed",
            "not-checked"
          ]
        },
        "observedAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        },
        "issue": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "unavailable",
                  "failed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "issue"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "reachable",
                  "not-checked"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "issue"
              ]
            }
          }
        }
      ]
    },
    "ExternalUpstreamStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "connection",
        "observedAt"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "failed",
            "unsupported"
          ]
        },
        "connection": {
          "$ref": "#/$defs/ConnectionObservation"
        },
        "capabilityDocumentReference": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/ResourceReference"
        },
        "capabilityRevision": {
          "type": "integer",
          "minimum": 1
        },
        "observedAt": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Timestamp"
        },
        "issue": {
          "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/Issue"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "available"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "capabilityDocumentReference",
              "capabilityRevision"
            ],
            "not": {
              "required": [
                "issue"
              ]
            },
            "properties": {
              "connection": {
                "properties": {
                  "state": {
                    "const": "reachable"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "unavailable",
                  "failed",
                  "unsupported"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "issue"
            ]
          }
        }
      ]
    }
  }
}
