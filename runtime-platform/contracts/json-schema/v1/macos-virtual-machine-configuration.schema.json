{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:macos-virtual-machine-configuration",
  "title": "MacOSVirtualMachineConfiguration",
  "description": "C32 Host-owned deployment configuration passed to the macOS virtual machine supervisor. It declares every Guest asset and resource identity needed to provision one persistent Guest runtime disk, construct one Apple Virtualization VM, expose Guest Runtime control, and expose declared public Guest services through Host-local HTTP-to-virtio-socket bridges. No path, network identity, boot argument, public route target, control transport, or release-to-runtime disk transition is inferred by the supervisor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "machineId", "cpuCount", "memoryBytes", "boot", "guestBootConsoleCapture", "guestRuntimeDiskProvisioning", "guestRuntimeControlHostLocalHTTPBridge", "guestPublicServiceHostLocalHTTPBridges", "storageDevices", "network"],
  "properties": {
    "schemaVersion": { "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion" },
    "machineId": { "$ref": "#/$defs/DeploymentIdentifier" },
    "cpuCount": { "type": "integer", "minimum": 1 },
    "memoryBytes": { "type": "integer", "minimum": 1 },
    "boot": { "$ref": "#/$defs/LinuxBootResources" },
    "guestBootConsoleCapture": { "$ref": "#/$defs/GuestBootConsoleCapture" },
    "guestRuntimeDiskProvisioning": { "$ref": "#/$defs/GuestRuntimeDiskProvisioning" },
    "guestRuntimeControlHostLocalHTTPBridge": { "$ref": "#/$defs/GuestRuntimeControlHostLocalHTTPBridge" },
    "guestPublicServiceHostLocalHTTPBridges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/GuestPublicServiceHostLocalHTTPBridge" }
    },
    "storageDevices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/VirtualMachineStorageDevice" }
    },
    "network": { "$ref": "#/$defs/VirtualMachineNetworkDevice" }
  },
  "$defs": {
    "DeploymentIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "SafeAbsolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/[^\\\\]*$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "LinuxBootResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernelPath", "guestRootDevicePath", "commandLine"],
      "properties": {
        "kernelPath": { "$ref": "#/$defs/SafeAbsolutePath" },
        "guestRootDevicePath": {
          "description": "Guest-visible C43 MBR root partition named explicitly by the Host boot configuration; it is not inferred from a Host disk-image path.",
          "const": "/dev/vda1"
        },
        "initialRamdiskPath": {
          "anyOf": [
            { "$ref": "#/$defs/SafeAbsolutePath" },
            { "type": "null" }
          ]
        },
        "commandLine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "(^|\\s)root=/dev/vda1(\\s|$)"
        }
      }
    },
    "GuestBootConsoleCapture": {
      "description": "Host-owned append-only diagnostic output for the Guest kernel and early boot console. It is not Guest Runtime state or a lifecycle success signal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["capturePath", "writeMode"],
      "properties": {
        "capturePath": { "$ref": "#/$defs/SafeAbsolutePath" },
        "writeMode": { "const": "append" }
      }
    },
    "GuestRuntimeDiskProvisioning": {
      "description": "Host-owned provisioning configuration that keeps immutable C34 guest-root release bytes separate from the writable VM attachment.",
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseArtifactManifestPath", "releaseArtifactPath", "runtimeDiskImagePath", "provisioningReceiptPath", "existingRuntimeDiskPolicy"],
      "properties": {
        "releaseArtifactManifestPath": { "$ref": "#/$defs/SafeAbsolutePath" },
        "releaseArtifactPath": { "$ref": "#/$defs/SafeAbsolutePath" },
        "runtimeDiskImagePath": { "$ref": "#/$defs/SafeAbsolutePath" },
        "provisioningReceiptPath": { "$ref": "#/$defs/SafeAbsolutePath" },
        "existingRuntimeDiskPolicy": { "const": "retain-when-receipt-matches-release-artifact" }
      }
    },
    "GuestRuntimeControlHostLocalHTTPBridge": {
      "description": "Host-owned bridge declaration that binds the Host Agent's loopback HTTP endpoint to the Guest Runtime's virtio-socket listener. The Host must not use a guessed or NAT-assigned Guest IP address for this control path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["hostLoopbackAddress", "hostLoopbackPort", "guestVirtioSocketPort"],
      "properties": {
        "hostLoopbackAddress": { "const": "127.0.0.1" },
        "hostLoopbackPort": { "$ref": "#/$defs/Port" },
        "guestVirtioSocketPort": { "$ref": "#/$defs/Port" }
      }
    },
    "GuestPublicServiceHostLocalHTTPBridge": {
      "description": "Host-owned bridge declaration for one C36 public route. It binds one Host loopback HTTP target to one C37 Guest public-service virtio-socket listener; it does not expose a NAT Guest IP address.",
      "type": "object",
      "additionalProperties": false,
      "required": ["routeId", "hostLoopbackAddress", "hostLoopbackPort", "guestVirtioSocketPort"],
      "properties": {
        "routeId": { "$ref": "#/$defs/DeploymentIdentifier" },
        "hostLoopbackAddress": { "const": "127.0.0.1" },
        "hostLoopbackPort": { "$ref": "#/$defs/Port" },
        "guestVirtioSocketPort": { "$ref": "#/$defs/Port" }
      }
    },
    "VirtualMachineStorageDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "storageImageFormat", "diskImagePath", "readOnly", "attachmentIndex"],
      "properties": {
        "id": { "$ref": "#/$defs/DeploymentIdentifier" },
        "role": { "enum": ["guest-root-storage", "guest-product-bootstrap-volume"] },
        "storageImageFormat": { "const": "raw" },
        "guestVolumeFileSystem": { "enum": ["iso9660"] },
        "diskImagePath": { "$ref": "#/$defs/SafeAbsolutePath" },
        "readOnly": { "type": "boolean" },
        "attachmentIndex": { "type": "integer", "minimum": 0, "maximum": 1 }
      },
      "oneOf": [
        {
          "properties": {
            "id": { "const": "guest-root" },
            "role": { "const": "guest-root-storage" },
            "storageImageFormat": { "const": "raw" },
            "readOnly": { "const": false },
            "attachmentIndex": { "const": 0 }
          },
          "not": { "required": ["guestVolumeFileSystem"] }
        },
        {
          "properties": {
            "id": { "const": "guest-product-bootstrap" },
            "role": { "const": "guest-product-bootstrap-volume" },
            "storageImageFormat": { "const": "raw" },
            "guestVolumeFileSystem": { "const": "iso9660" },
            "readOnly": { "const": true },
            "attachmentIndex": { "const": 1 }
          },
          "required": ["guestVolumeFileSystem"]
        }
      ]
    },
    "VirtualMachineNetworkDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment", "macAddress"],
      "properties": {
        "attachment": { "const": "nat" },
        "macAddress": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f][02468AaCcEe](:[0-9A-Fa-f]{2}){5}$"
        }
      }
    },
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
