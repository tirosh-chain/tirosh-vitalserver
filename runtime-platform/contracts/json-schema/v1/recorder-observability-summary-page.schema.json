{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tirosh:vitalserver:runtime-platform:v1:recorder-observability-summary-page",
  "title": "RecorderObservabilitySummaryPage",
  "description": "One Catalog-owned bounded page of current Recorder projections ordered by Recorder identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:common#/$defs/SchemaVersion"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "urn:tirosh:vitalserver:runtime-platform:v1:recorder-observability-summary"
      }
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
