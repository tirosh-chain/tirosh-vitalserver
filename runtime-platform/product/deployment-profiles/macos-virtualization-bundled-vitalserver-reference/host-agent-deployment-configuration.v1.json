{
  "schemaVersion": "v1",
  "control": {
    "localAdministration": {
      "transport": "unix-domain-socket",
      "endpointAddress": "/Library/Application Support/VitalServerRuntimePlatform/control/host-agent.sock",
      "descriptorPath": "/Library/Application Support/VitalServerRuntimePlatform/control/host-agent.local.json",
      "authorizedUserId": 501
    },
    "loopbackHTTP": { "mode": "disabled" },
    "stateDatabasePath": "/Library/Application Support/VitalServerRuntimePlatform/data/host-agent/host-agent.sqlite",
    "guestTimeoutMilliseconds": 5000
  },
  "installation": {
    "installationId": "vitalserver-runtime-platform-macos-bundled-reference",
    "productVersion": "0.2.0-dev",
    "runtimeVersion": "0.2.0-dev",
    "dataDirectory": "/Library/Application Support/VitalServerRuntimePlatform/data"
  },
  "guestRuntimeControlEndpoint": {
    "id": "vitalserver-guest-runtime-control-endpoint",
    "scheme": "http",
    "host": "127.0.0.1",
    "port": 18443
  },
  "operationalStateBackup": {
    "scheduleId": "daily-primary",
    "intervalSeconds": 86400,
    "retryIntervalSeconds": 60,
    "destinationReference": {
      "resourceType": "guest-backup-destination",
      "resourceId": "guest-local-operational-state"
    },
    "retentionPolicy": "retain-all"
  },
  "provider": {
    "kind": "macos-virtualization",
    "id": "vitalserver-macos-virtualization-bundled-reference-provider",
    "macOSVirtualMachineSupervisorExecutablePath": "/Library/Application Support/VitalServerRuntimePlatform/current/bin/macos-virtual-machine-supervisor",
    "macOSVirtualMachineConfigurationPath": "/Library/Application Support/VitalServerRuntimePlatform/current/config/macos-virtual-machine.json"
  },
  "time": {
    "hostNodeId": "vitalserver-macos-bundled-reference-host",
    "timeAuthorityId": "vitalserver-macos-bundled-reference-time-authority",
    "kind": "time-authority-outcome-profile",
    "providerMode": "unsupported"
  },
  "telemetry": {
    "kind": "telemetry-export-outcome-profile",
    "pipelineMode": "unsupported",
    "exportMode": "unavailable"
  },
  "updateBootstrap": {
    "mode": "staged",
    "bundleStoreDirectory": "/Library/Application Support/VitalServerRuntimePlatform/data/update-bundles",
    "stagingDirectory": "/Library/Application Support/VitalServerRuntimePlatform/data/update-staging",
    "trustStorePath": "/Library/Application Support/VitalServerRuntimePlatform/current/config/update-trust-store.json"
  }
}
