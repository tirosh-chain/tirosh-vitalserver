# Render with:
#   VITALSERVER_PROXY_PORT=80 PROXY_UPSTREAM=127.0.0.1:18080 make proxy-config
#
# The proxy must run on the macOS host. It preserves the VR device source IP
# before the request enters Docker, OrbStack, or the Linux VM shared/NAT network.

worker_processes 1;
error_log "${VITALSERVER_PROXY_NGINX_ERROR_LOG}";
pid logs/nginx.pid;

events {
    worker_connections 1024;
}

http {
    access_log "${VITALSERVER_PROXY_NGINX_ACCESS_LOG}";
    error_log "${VITALSERVER_PROXY_NGINX_ERROR_LOG}";
    client_body_temp_path temp/client_body;
    proxy_temp_path temp/proxy;
    fastcgi_temp_path temp/fastcgi;
    uwsgi_temp_path temp/uwsgi;
    scgi_temp_path temp/scgi;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen ${VITALSERVER_PROXY_PORT};
        server_name _;

        location = /health {
            access_log off;
            default_type text/plain;
            return 204;
        }

        location = /ready {
            proxy_pass http://${PROXY_UPSTREAM}/ready;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Client-IP $remote_addr;
            proxy_set_header Forwarded "for=$remote_addr;proto=$scheme;host=$host";
        }

        location / {
            proxy_pass http://${PROXY_UPSTREAM};
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Overwrite client-supplied forwarding headers at the trust boundary.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Client-IP $remote_addr;
            proxy_set_header Forwarded "for=$remote_addr;proto=$scheme;host=$host";
        }
    }
}
